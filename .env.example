# Copy to .env on the CONTROL VM only. Never commit .env. Never place these in the sandbox.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
DR_MODELS_FILE=models.yaml
DR_DATASET_SEED=20261103
DR_DOCKER_HOST=                 # empty = local docker (T0); ssh://runner@<sandbox-host> = T1
DR_RUN_TOKEN_CAP=UNSET
DR_DAILY_TOKEN_BUDGET=UNSET
DR_RATE_LIMIT_RUNS_PER_IP_PER_HOUR=UNSET
DR_PUBLIC_BASE_URL=
DR_OPERATOR_TOKEN=              # protects operator-only routes (stress test); long random value
DR_PACKET_LINK_TTL_SECONDS=UNSET    # UNSET means public download links are refused
DR_RECORDED_RUNS_DIR=
DR_STATIC_DIR=
DR_TRUST_PROXY=
DR_RUNS_DIR=
DR_OPERATION_SECONDS=UNSET      # the operator Docker command deadline; no default, the app refuses to start while UNSET
DR_IMAGE_LOCK=                  # empty = docker_image.lock at the code root (the path M4 reads)
DR_ALLOW_PROVISIONAL_DATASET=   # 1 = accept the synthetic core dataset while G14 weather is unsourced
DR_OPERATOR_MODE=               # 1 = operator mode (I-4): live inference on; needs DR_OPERATOR_TOKEN and DR_RATE_LIMIT_RUNS_PER_IP_PER_HOUR=UNSET; unset = public mode
