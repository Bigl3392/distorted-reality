{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.distortedreality.example/evidence_packet.schema.json",
  "title": "Contract C3: Evidence packet (the product output)",
  "type": "object",
  "properties": {
    "label": {
      "const": "SYNTHETIC"
    },
    "packet_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_statement": {
      "const": "The calculation executed successfully under these assumptions. This does not establish that any intervention will improve an actual business."
    },
    "synthetic_notice": {
      "type": "string"
    },
    "dataset": {
      "$ref": "dataset_manifest.schema.json"
    },
    "mri": {
      "$ref": "mri_inventory.schema.json"
    },
    "scan": {
      "$ref": "scan_result.schema.json"
    },
    "council": {
      "$ref": "council_run.schema.json"
    },
    "decision_rule": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frozen_before_execution": {
          "const": true
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "frozen_before_execution",
        "text"
      ],
      "additionalProperties": false
    },
    "executions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "blackbox_run.schema.json"
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "PATH_PREFERRED_UNDER_ASSUMPTIONS",
            "NO_SUFFICIENT_EVIDENCE"
          ]
        },
        "preferred_path_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "result",
        "preferred_path_id",
        "basis"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "executed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "did_not_prove": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "containment": {
      "type": "object",
      "properties": {
        "stress_test_run": {
          "type": "boolean"
        },
        "stress_termination": {
          "type": [
            "string",
            "null"
          ]
        },
        "control_plane_heartbeat_gap_max_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "stress_test_run",
        "stress_termination",
        "control_plane_heartbeat_gap_max_ms"
      ],
      "additionalProperties": false
    },
    "approval_gate": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "VIEWED_CONFIRMED"
          ]
        },
        "external_action_taken": {
          "const": false
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "external_action_taken",
        "confirmed_at"
      ],
      "additionalProperties": false
    },
    "assurance_tier": {
      "enum": [
        "T0",
        "T1"
      ]
    },
    "journal": {
      "type": "object",
      "properties": {
        "head_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "integer"
        }
      },
      "required": [
        "head_sha256",
        "entries"
      ],
      "additionalProperties": false
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "label",
    "packet_version",
    "run_id",
    "built_at",
    "claim_statement",
    "synthetic_notice",
    "dataset",
    "mri",
    "scan",
    "council",
    "decision_rule",
    "executions",
    "outcome",
    "assumptions",
    "unknowns",
    "executed",
    "did_not_prove",
    "limitations",
    "containment",
    "approval_gate",
    "assurance_tier",
    "journal",
    "packet_sha256"
  ],
  "additionalProperties": false
}
