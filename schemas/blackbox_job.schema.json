{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.distortedreality.example/blackbox_job.schema.json",
  "title": "Contract C2: council -> Blackbox (one job per surviving path)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "C2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "path_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "intervention": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "who_does_what": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "does": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "does"
            ],
            "additionalProperties": false
          }
        },
        "order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distinct_from": {
          "type": "string",
          "description": "how this differs materially from the other two paths"
        }
      },
      "required": [
        "summary",
        "who_does_what",
        "order",
        "checks",
        "automation",
        "distinct_from"
      ],
      "additionalProperties": false
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "decision_rule_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caps": {
      "type": "object",
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1024
        },
        "pids": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "wall_seconds",
        "memory_mb",
        "pids",
        "cpus",
        "stdout_bytes"
      ],
      "additionalProperties": false
    },
    "network": {
      "const": "none"
    },
    "secrets_in_job": {
      "const": false
    },
    "approval_required_for_external_action": {
      "const": true
    }
  },
  "required": [
    "contract",
    "run_id",
    "path_id",
    "intervention",
    "dataset_id",
    "dataset_sha256",
    "test_id",
    "decision_rule_sha256",
    "caps",
    "network",
    "secrets_in_job",
    "approval_required_for_external_action"
  ],
  "additionalProperties": false
}