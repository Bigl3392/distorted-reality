{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.distortedreality.example/limits_record.schema.json",
  "title": "Measurement-to-configuration record for X7 = B limits",
  "description": "Per-run token cap, global daily token budget and per-IP run limit are NOT set in the spec. They are set at BUILD after the first measured run and recorded here. Until a record with status LDR_APPROVED exists, the three env values stay UNSET and the broker refuses live public inference (recorded real-run fallback only). FIXTURE records are shape tests and carry no authority.",
  "type": "object",
  "properties": {
    "record_status": {
      "enum": [
        "FIXTURE",
        "MEASURED_PROPOSED",
        "LDR_APPROVED"
      ]
    },
    "record_id": {
      "$ref": "common.defs.json#/$defs/id"
    },
    "measured_run_id": {
      "$ref": "common.defs.json#/$defs/id"
    },
    "measured_at": {
      "$ref": "common.defs.json#/$defs/timestamp"
    },
    "measured_by": {
      "type": "string",
      "minLength": 1
    },
    "measurement": {
      "type": "object",
      "properties": {
        "calls_total": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_total": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_by_role": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "calls_total",
        "tokens_total",
        "tokens_by_role"
      ],
      "additionalProperties": false
    },
    "proposed": {
      "type": "object",
      "properties": {
        "run_token_cap": {
          "type": "integer",
          "minimum": 1
        },
        "daily_token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "runs_per_ip_per_hour": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "run_token_cap",
        "daily_token_budget",
        "runs_per_ip_per_hour"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "recorded_run_fallback_id": {
      "$ref": "common.defs.json#/$defs/id",
      "description": "run_id of the labeled recorded real run served when limits are exhausted (mandatory under X7 = B)"
    },
    "approved_by": {
      "const": "LDR"
    },
    "approved_at": {
      "$ref": "common.defs.json#/$defs/timestamp"
    }
  },
  "required": [
    "record_status",
    "record_id",
    "measured_run_id",
    "measured_at",
    "measured_by",
    "measurement",
    "proposed",
    "rationale"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "LDR_APPROVED"
          }
        }
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at",
          "recorded_run_fallback_id"
        ]
      }
    }
  ]
}